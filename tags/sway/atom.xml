&lt;span class=&quot;giallo-l&quot;&gt;&lt;span class=&quot;z-8&quot;&gt;  --platform=wayland --enable-features=UseOzonePlatform --password-store=&lt;/span&gt;&lt;span class=&quot;z-2&quot;&gt;&amp;quot;gnome_libsecret&amp;quot;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;</content>
        
